+            raise ValueError("unlock_channel_first")
+        if candidate["enabled"] and any(c["channel"]!=ch and c["enabled"] and c["name"].lower()==candidate["name"].lower() for c in self.channels):
+            raise ValueError("give_each_servo_a_unique_name")
