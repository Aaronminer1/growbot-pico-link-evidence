+        plan=dict(version=1,name='Taught Turn',cycles=1,steps=sequence,
+                  speed_us_s=walk.get('speed_us_s',150),lift_percent=walk.get('lift_percent',50),
+                  paired_feet=True,settle_ms=walk.get('settle_ms',20))
